# ============================================
# Immersive Voice Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# On HuggingFace Spaces, set these in Settings > Secrets.

# ============================================
# REQUIRED FOR GRADIO WEB APP (app.py)
# ============================================

# OpenAI API Key (Required)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Deepgram API Key (Required - STT)
# Get it from: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ElevenLabs API Key (Required - TTS)
# Get it from: https://elevenlabs.io/app/sign-up
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ============================================
# REQUIRED FOR TERMINAL AGENT (universal_agent_v3.py)
# ============================================

# Daily.co Room URL (Required for terminal mode only)
# Create a room at: https://dashboard.daily.co/rooms
# IMPORTANT: Configure the room as PUBLIC in Daily.co dashboard
# DAILY_ROOM_URL=https://your-domain.daily.co/your-room-name

# Daily.co Token (Optional - leave empty for public rooms)
# DAILY_TOKEN=
