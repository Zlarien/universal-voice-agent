# ============================================
# Universal Voice Agent v3.0 - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# REQUIRED FOR ALL MODES
# ============================================

# OpenAI API Key (Required for both modes)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Daily.co Room URL (Required)
# Create a room at: https://dashboard.daily.co/rooms
# Format: https://your-domain.daily.co/your-room-name
# IMPORTANT: Configure the room as PUBLIC in Daily.co dashboard
DAILY_ROOM_URL=https://your-domain.daily.co/your-room-name

# Daily.co Token (Optional - leave empty for public rooms)
DAILY_TOKEN=

# ============================================
# REQUIRED FOR PIPELINE MODE ONLY
# ============================================

# Deepgram API Key (Required for Pipeline mode - STT)
# Get it from: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ElevenLabs API Key (Required for Pipeline mode - TTS)
# Get it from: https://elevenlabs.io/app/sign-up
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ============================================
# OPTIONAL SETTINGS
# ============================================

# ElevenLabs Voice Settings (Optional)
# ELEVENLABS_DEFAULT_VOICE_ID=XB0fDUnXU5powFXDhCwa
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75

# Deepgram Model (Optional)
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_LANGUAGE=fr
